{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "kube-dns",
    "namespace": "kube-system",
    "uid": "u-kube-system-service-kube-dns"
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "k8s-app": "kube-dns"
    },
    "ports": [
      {
        "port": 53,
        "targetPort": 53,
        "protocol": "TCP"
      }
    ]
  }
}
