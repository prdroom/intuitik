{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "web",
    "namespace": "shop",
    "uid": "u-shop-service-web"
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "web"
    },
    "ports": [
      {
        "port": 80,
        "targetPort": 8080,
        "protocol": "TCP"
      }
    ]
  }
}
