{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "api",
    "namespace": "shop",
    "uid": "u-shop-service-api"
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "api"
    },
    "ports": [
      {
        "port": 80,
        "targetPort": "http",
        "protocol": "TCP"
      }
    ]
  }
}
