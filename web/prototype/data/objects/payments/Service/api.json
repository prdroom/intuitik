{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "api",
    "namespace": "payments",
    "uid": "u-payments-service-api"
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "payments-api"
    },
    "ports": [
      {
        "port": 80,
        "targetPort": 8080,
        "protocol": "TCP"
      }
    ]
  }
}
